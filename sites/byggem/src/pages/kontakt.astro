---
/**
 * byggem.no – kontakt og «Be om pris». Fasit: docs/design/byggem/Kontakt.dc.html.
 * Skjemaet lagrer og sender ingenting selv: «Send henvendelse» åpner en ferdig utfylt e-post til post@byggem.no (mailto).
 * Uten JavaScript gjør skjemaet ingenting (method="dialog"), så ingen opplysninger havner i en adresse eller logg.
 */
import Side from "../layouts/Side.astro";
import { TYPER } from "../content/innhold";
import { selskap } from "../content/selskap";

const felt = [
  { navn: "name", label: "Navn *", type: "text", maks: 100, auto: "name", krav: true },
  { navn: "company", label: "Firma", type: "text", maks: 120, auto: "organization", krav: false },
  { navn: "phone", label: "Telefon *", type: "tel", auto: "tel", krav: true, modus: "tel" },
  { navn: "email", label: "E-post *", type: "email", maks: 255, auto: "email", krav: true },
];
---
<Side
  title="Kontakt byggEM | Be om pris"
  description="Kontakt byggEM om montasje eller mindre snekkeroppdrag i Trondheim og omegn. Vi svarer innen én arbeidsdag."
  ogBeskrivelse="Send oss informasjon om jobben, eller ring 976 06 500."
  aktiv="kontakt"
>
  <main id="innhold">
    <section class="b-seksjon topp">
      <div class="wrap">
        <p class="b-eyebrow">Kontakt</p>
        <h1 class="tittel">Be om pris</h1>
        <p class="b-ingress ingress">Fortell hva jobben gjelder. Vi svarer innen én arbeidsdag.</p>
        <p class="b-meta meta">{selskap.telefon} · {selskap.epost} · {selskap.omrade}</p>
      </div>
    </section>

    <section class="b-seksjon">
      <div class="wrap rutenett">
        <form method="dialog" novalidate data-skjema>
          <div class="par">
            {felt.map((f) => (
              <div class="felt" data-felt={f.navn}>
                <label for={`f-${f.navn}`}>{f.label}</label>
                <input id={`f-${f.navn}`} name={f.navn} type={f.type} maxlength={f.maks} autocomplete={f.auto}
                       inputmode={f.modus} required={f.krav} aria-describedby={`feil-${f.navn}`} />
                <span class="feil" id={`feil-${f.navn}`} data-feil={f.navn}></span>
              </div>
            ))}
          </div>
          <div class="felt" data-felt="subject">
            <label for="f-subject">Hva gjelder det? *</label>
            <span class="velg">
              <select id="f-subject" name="subject" required aria-describedby="feil-subject">
                {TYPER.map((t) => <option>{t}</option>)}
              </select>
            </span>
            <span class="feil" id="feil-subject" data-feil="subject"></span>
          </div>
          <div class="felt">
            <label for="f-location">Sted for jobben</label>
            <input id="f-location" name="location" type="text" maxlength="150" autocomplete="address-level2" />
          </div>
          <div class="felt" data-felt="description">
            <label for="f-description">Beskrivelse *</label>
            <textarea id="f-description" name="description" rows="7" maxlength="3000" required aria-describedby="feil-description"></textarea>
            <span class="feil" id="feil-description" data-feil="description"></span>
          </div>
          <div class="samtykke" data-felt="consent">
            <label>
              <input type="checkbox" name="consent" aria-describedby="feil-consent" />
              <span>Jeg godtar at byggEM lagrer opplysningene for å svare på henvendelsen. Les <a href="/personvern">personvernerklæringen</a>.</span>
            </label>
            <span class="feil" id="feil-consent" data-feil="consent"></span>
          </div>
          <div><button class="b-btn primar" type="submit">Send henvendelse</button></div>
        </form>
        <aside>
          <h2 class="b-h3">Kontakt</h2>
          <p class="linjer"><a href={selskap.telefonHref}>{selskap.telefon}</a><br /><a href={`mailto:${selskap.epost}`}>{selskap.epost}</a></p>
          <p class="omrade">Vi jobber i {selskap.omrade}.</p>
        </aside>
      </div>
    </section>
  </main>
</Side>

<script>
  // Sjekker feltene og åpner en ferdig utfylt e-post. Feilmeldingene er de samme som i designet (Kontakt.dc.html).
  const skjema = document.querySelector<HTMLFormElement>("[data-skjema]");
  skjema?.addEventListener("submit", (e) => {
    e.preventDefault();
    const f = new FormData(skjema);
    const v = (k: string) => String(f.get(k) ?? "").trim();
    const feil: Record<string, string> = {};
    if (!v("name")) feil.name = "Skriv navnet ditt.";
    if (!v("phone")) feil.phone = "Skriv et telefonnummer vi kan ringe.";
    if (!v("email").includes("@")) feil.email = "Skriv en gyldig e-postadresse.";
    if (!v("subject") || v("subject") === "Velg type oppdrag") feil.subject = "Velg hva det gjelder.";
    if (!v("description")) feil.description = "Skriv kort hva jobben gjelder.";
    if (!f.get("consent")) feil.consent = "Kryss av for å sende.";

    for (const el of skjema.querySelectorAll<HTMLElement>("[data-feil]")) {
      const navn = el.dataset.feil!;
      el.textContent = feil[navn] ?? "";
      skjema.querySelector(`[data-felt="${navn}"]`)?.classList.toggle("ugyldig", !!feil[navn]);
      skjema.querySelector(`[name="${navn}"]`)?.setAttribute("aria-invalid", String(!!feil[navn]));
    }
    const forste = Object.keys(feil)[0];
    if (forste) {
      skjema.querySelector<HTMLElement>(`[name="${forste}"]`)?.focus();
      return;
    }
    const linjer = [
      "Navn: " + v("name"), v("company") ? "Firma: " + v("company") : "", "Telefon: " + v("phone"), "E-post: " + v("email"),
      "Gjelder: " + v("subject"), v("location") ? "Sted: " + v("location") : "", "", v("description"),
    ].filter((l, i) => l !== "" || i === 6);
    location.href = "mailto:post@byggem.no?subject=" + encodeURIComponent("Be om pris – " + v("subject")) + "&body=" + encodeURIComponent(linjer.join("\n"));
  });
</script>

<style>
  .topp { border-bottom: 1px solid var(--linje); }
  .tittel { margin-top: 20px; max-width: 20ch; }
  .ingress { margin-top: 32px; }
  .meta { margin-top: 24px; }
  .rutenett { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 48px; }
  form { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
  .par { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .felt { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .felt label { font-size: 14px; line-height: 18px; font-weight: 500; }
  input:not([type="checkbox"]), select, textarea {
    font: inherit; font-size: 17px; line-height: 24px; color: var(--tekst); background: var(--bakgrunn);
    border: 1px solid var(--linje-sterk); border-radius: var(--radius-pille); padding: 12px 16px; width: 100%;
  }
  textarea { min-height: 120px; resize: vertical; }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--fokus); outline-offset: 1px; }
  .velg { position: relative; display: block; }
  select { appearance: none; padding-right: 44px; }
  .velg::after {
    content: ""; position: absolute; right: 18px; top: 50%; width: 8px; height: 8px; margin-top: -6px;
    border-right: 1.5px solid var(--tekst); border-bottom: 1.5px solid var(--tekst); transform: rotate(45deg); pointer-events: none;
  }
  .ugyldig input, .ugyldig textarea, .ugyldig select { border-color: var(--feil); border-width: 2px; }
  .feil { font-size: 14px; line-height: 20px; font-weight: 500; color: var(--feil); }
  .feil:empty { display: none; }
  .samtykke { display: flex; flex-direction: column; gap: 8px; }
  .samtykke label { display: flex; gap: 12px; align-items: flex-start; font-size: 15px; line-height: 22px; }
  .samtykke input { width: 20px; height: 20px; margin: 1px 0 0; flex: none; accent-color: var(--aksent); }
  aside { border-left: 1px solid var(--linje); padding-left: 32px; }
  .linjer { margin-top: 20px; }
  .omrade { margin-top: 32px; }
  @media (max-width: 1023px) {
    .rutenett { grid-template-columns: minmax(0, 1fr); }
    aside { border-left: 0; border-top: 1px solid var(--linje); padding: 32px 0 0; }
  }
  @media (max-width: 859px) { .par { grid-template-columns: minmax(0, 1fr); } }
</style>
