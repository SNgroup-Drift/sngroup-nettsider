---
/** byggem.no – personvern i familiens personvernmal. Fasit: docs/design/byggem/Personvern.dc.html. */
import Side from "../layouts/Side.astro";
import PrivacyPage from "@sngroup/design/components/PrivacyPage.astro";
import { personvern } from "../content/personvern";
---
<Side title="Personvern | byggEM" description="Informasjon om behandling og lagring av kontaktskjemaopplysninger.">
  <main id="innhold" class="personvern">
    <PrivacyPage {...personvern} />
  </main>
</Side>

<style>
  .personvern { flex: 1; }
  /* byggEM-typografi i malen: h1 44 px Poppins 300, radoverskrifter 22 px Poppins 500, eyebrow med sperring */
  .personvern :global(h1) { font-size: 44px; line-height: 1.05; font-weight: 300; letter-spacing: -0.02em; max-width: 20ch; }
  .personvern :global(h2) { font-size: 22px; line-height: 1.2; font-weight: 500; letter-spacing: 0; }
  .personvern :global(.label) { font-size: 14px; line-height: 18px; letter-spacing: 0.08em; }
  .personvern :global(.ingress) { font-size: 26px; line-height: 34px; max-width: 65ch; margin-top: 32px; }
  .personvern :global(.tekst a) { color: var(--aksent); }
  @media (max-width: 767px) {
    .personvern :global(h1) { font-size: 32px; }
    .personvern :global(.ingress) { font-size: 20px; line-height: 28px; }
  }
</style>
