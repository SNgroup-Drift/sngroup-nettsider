// Cloudflare Worker for hengsel: statiske filer fra ./dist. Bygg med `npm run build -w sites/hengsel` først. Se docs/hosting.md.
// Hele hengsel.no er statisk, også /apptest (10.10.2026: passordet og Worker-skriptet er fjernet). Hemmelighetene
// APPTEST_PASSORD, APPTEST_NOKKEL og DEMO_PASSORD brukes ikke lenger og kan slettes i Cloudflare.
// Workers Builds: både Deploy command og Non-production branch deploy command må ha `-c sites/hengsel/wrangler.jsonc`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hengsel",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Ukjente sider får dist/404.html med status 404
    "not_found_handling": "404-page",
    // /personvern serverer personvern.html; /personvern.html sendes til /personvern
    "html_handling": "auto-trailing-slash"
  }
}
