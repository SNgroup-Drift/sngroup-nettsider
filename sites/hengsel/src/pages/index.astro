---
/**
 * hengsel.no – forsiden. Fasit: docs/design/hengsel/Forside.dc.html (Claude Design, godkjent 07.10.2026).
 * Rekkefølge: hero → hvorfor, løsningen, se løsningen, montørappen, roller, også i løsningen, integrasjoner,
 * leverandørene → kundereisen, prinsippene, kom i gang → spørsmål → kontakt.
 * All tekst ligger i content/forside.ts. Samspillet ligger i scripts/forside.ts (ingen inline-skript, CSP script-src 'self').
 */
import Side from "../layouts/Side.astro";
import Enhet from "../components/Enhet.astro";
import Plantegningsstrek from "@sngroup/design/components/Plantegningsstrek.astro";
import {
  HERO, WHY, TRIO, STEPS, TOUR, PH, ROLES, MORE, INTEG, ACCT, SUPP, PRINC, CHECK, FAQ, INTS, ADDR,
} from "../content/forside";

const omrader = Object.keys(TOUR) as (keyof typeof TOUR)[];
const forsteSteg = STEPS[0];
const facts = ["Bygget i en kjøkkenbutikk med tre avdelinger", "PC, iPad og telefon", "Tegninger fra CET leses rett inn"];
const reiseData = STEPS.map(([tittel, skjerm, tekst, eier, bilde]) => ({ tittel, skjerm, tekst, eier, bilde }));
---
<Side
  title="Hengsel – for kjøkken- og interiørbutikker"
  description="Hengsel samler salg, tilbud, bestilling, montasje, montørapp og kundeportal for kjøkken- og interiørbutikker i ett system."
  forside
  demo
>
  <main id="innhold">
    <!-- Hero -->
    <section class="hero">
      <div class="wrap hero-rutenett">
        <div class="hero-tekst">
          <span class="h-eyebrow">For kjøkken- og interiørbutikker</span>
          <h1>Fra første henvendelse til ferdig montert kjøkken.</h1>
          <p class="h-lede stor">Hengsel er butikkens system for salg, tilbud, bestilling, montasje og kundeportal, med egen app for montørene. Alt havner på samme ordre og samme kundekort, så ingen må spørre hverandre om hvor ting står.</p>
          <div class="knapper">
            <a class="h-btn primar" href="#kontakt">Book en gjennomgang</a>
            <a class="h-btn" href="#losningen">Se skjermbildene</a>
          </div>
          <ul class="fakta">
            {facts.map((f) => <li>{f}</li>)}
          </ul>
        </div>
        <div class="hero-enhet">
          <div class="h-faner" role="tablist" aria-label="Vis på enhet" data-hero-faner>
            {["PC", "iPad", "Telefon", "Montør"].map((l, i) => (
              <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} aria-controls="hero-enhet"
                      data-bilde={HERO[i].bilde} data-type={HERO[i].type} data-alt={HERO[i].alt}>{l}</button>
            ))}
          </div>
          <div class="hero-flate">
            <Enhet id="hero-enhet" bilde={HERO[0].bilde} type={HERO[0].type} alt={HERO[0].alt} ratio={0.75} forst />
          </div>
        </div>
      </div>
    </section>

    <!-- Hvorfor -->
    <section id="hvorfor" class="h-seksjon baand">
      <div class="wrap">
        <div class="h-hode">
          <span class="h-eyebrow">Hvorfor</span>
          <h2>Et kjøkken går gjennom mange hender. Informasjonen skal ikke falle mellom dem.</h2>
          <p class="h-lede">Selgeren, bestilleren, montasjelederen, montøren og kunden trenger det samme kjøkkenet beskrevet likt. Når det ligger i e-post, regneark, lapper og hver sin app, blir det feil som koster tid og margin.</p>
        </div>
        <div class="h-faner pa-kort sammenlign" role="tablist" aria-label="Sammenlign" data-hvorfor>
          <button type="button" role="tab" id="hv-before" aria-controls="hv-panel-before" aria-selected="false" data-id="before">Uten et felles system</button>
          <button type="button" role="tab" id="hv-after" aria-controls="hv-panel-after" aria-selected="true" data-id="after">Med Hengsel</button>
        </div>
        {(["before", "after"] as const).map((v) => (
          <div class="kort-rutenett bred" role="tabpanel" id={`hv-panel-${v}`} aria-labelledby={`hv-${v}`} hidden={v === "before"} data-hvorfor-panel={v}>
            {WHY.map((c) => {
              const [tittel, tekst] = c[v];
              return (
                <article class="h-kort hvorfor-kort">
                  <span class:list={["h-pille", v === "after" ? "ok" : "feil"]}>{v === "after" ? "Med Hengsel" : "I dag"}</span>
                  <h3>{tittel}</h3>
                  <p class="h-dempet">{tekst}</p>
                </article>
              );
            })}
          </div>
        ))}
      </div>
    </section>

    <!-- Løsningen: tre flater -->
    <section id="produktene" class="h-seksjon">
      <div class="wrap">
        <div class="h-hode">
          <span class="h-eyebrow">Løsningen</span>
          <h2>Tre flater, én database.</h2>
          <p class="h-lede">Det montøren registrerer, står rett på ordren. Det kunden velger i portalen, står rett på tilbudet. Ingen dobbel føring.</p>
        </div>
        <div class="kort-rutenett">
          {TRIO.map((t) => (
            <article class="h-kort trio">
              <span class="svak">{t.who}</span>
              <h3>{t.title}</h3>
              <ul class="h-dempet">{t.items.map((li) => <li>{li}</li>)}</ul>
              <p class="svak">{t.where}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Se løsningen -->
    <section id="losningen" class="h-seksjon baand">
      <div class="wrap">
        <div class="h-hode">
          <span class="h-eyebrow">Se løsningen</span>
          <h2>Skjermene, én for én.</h2>
          <p class="h-lede">Velg et område og en skjerm. Klikk på bildet for å se det i full størrelse. Alle navn og tall er demodata.</p>
        </div>
        <div class="h-chips omrader" role="tablist" aria-label="Områder" data-omrader>
          {omrader.map((o, i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-omrade={o}>{o}</button>
          ))}
        </div>
        <div class="tur">
          <div class="tur-lister">
            {omrader.map((o, oi) => (
              <div role="tablist" aria-label={`Skjermer: ${o}`} class="tur-liste" hidden={oi !== 0} data-tur-liste={o}>
                {TOUR[o].map((x, i) => (
                  <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} class="tur-valg"
                          data-bilde={x[2]} data-alt={`${x[0]}: skjermbilde`} data-punkter={`${o}-${i}`}>
                    <span class="tur-tittel">{x[0]}</span>
                    <span class="tur-tekst">{x[1]}</span>
                  </button>
                ))}
              </div>
            ))}
          </div>
          <div class="tur-visning">
            <Enhet id="tur-enhet" bilde={TOUR.Salg[0][2]} alt={`${TOUR.Salg[0][0]}: skjermbilde`} ratio={0.8} />
            {omrader.flatMap((o) => TOUR[o].map((x, i) => (
              <div class="punkter" hidden={!(o === "Salg" && i === 0)} data-punkt={`${o}-${i}`}>
                {x[3].map((p) => (
                  <div class="punkt"><b>{p[0]}</b><span>{p[1]}</span></div>
                ))}
              </div>
            )))}
          </div>
        </div>
      </div>
    </section>

    <!-- Montørappen -->
    <section id="hengsel" class="h-seksjon">
      <div class="wrap h-split midt">
        <div class="stabel">
          <span class="h-eyebrow">Montørappen</span>
          <h2>Hengsel: det montøren trenger, og ingenting mer.</h2>
          <p class="h-lede">Montøren ser neste jobb, hva som mangler og hvor nøkkelen ligger. Det som registreres på jobben, står med en gang på ordren hos kontoret.</p>
          <div class="h-chips" role="tablist" aria-label="Skjermer i Hengsel" data-ph>
            {PH.map((p, i) => (
              <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} aria-controls="ph-tekst"
                      data-bilde={p[1]} data-tekst={p[2]}>{p[0]}</button>
            ))}
          </div>
          <p class="h-dempet ph-tekst" id="ph-tekst" aria-live="polite" data-ph-tekst>{PH[0][2]}</p>
        </div>
        <div>
          <Enhet id="ph-enhet" bilde={PH[0][1]} alt="Hengsel: skjermbilde" ratio={1} />
        </div>
      </div>
    </section>

    <!-- Roller -->
    <section id="roller" class="h-seksjon baand">
      <div class="wrap">
        <div class="h-hode">
          <span class="h-eyebrow">Roller</span>
          <h2>Hver rolle ser det den bruker hver dag.</h2>
          <p class="h-lede">Menyen er kort og bestemt av rollen. Det en rolle ikke bruker daglig, ligger under «Mer». Leder og admin slår moduler av og på per rolle.</p>
        </div>
        <div class="h-chips roller-valg" role="tablist" aria-label="Velg rolle" data-roller>
          {ROLES.map((r, i) => (
            <button type="button" role="tab" id={`rolle-${i}`} aria-controls={`rolle-panel-${i}`} aria-selected={i === 0 ? "true" : "false"} data-i={i}>{r[0]}</button>
          ))}
        </div>
        {ROLES.map((r, i) => (
          <div class="rolle-kort" role="tabpanel" id={`rolle-panel-${i}`} aria-labelledby={`rolle-${i}`} hidden={i !== 0} data-rolle={i}>
            <div class="stabel liten">
              <span class="h-eyebrow">Menyen for {r[0].toLowerCase()}</span>
              <h3 class="stor">{r[0]}</h3>
              <ul class="meny">{r[1].map((m) => <li>{m}</li>)}</ul>
            </div>
            <ul class="gevinster">
              {r[2].map((g) => (
                <li>
                  <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"><circle class="hake-bunn" cx="9" cy="9" r="9" /><path class="hake" d="M5.5 9.3l2.2 2.2L12.5 6.6" /></svg>
                  <span><b>{g[0]}</b><br />{g[1]}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Også i løsningen -->
    <section id="mer" class="h-seksjon">
      <div class="wrap">
        <div class="h-hode">
          <span class="h-eyebrow">Også i løsningen</span>
          <h2>Mer enn salg og montasje.</h2>
        </div>
        <ul class="mer-rutenett">
          {MORE.map((m) => <li><b>{m[0]}</b><span>{m[1]}</span></li>)}
          <li class="fyll" aria-hidden="true"></li>
        </ul>
      </div>
    </section>

    <!-- Integrasjoner -->
    <section id="integrasjoner" class="h-seksjon baand">
      <div class="wrap">
        <div class="h-hode">
          <span class="h-eyebrow">Integrasjoner</span>
          <h2>Kobler seg på det dere allerede bruker.</h2>
          <p class="h-lede">Tegningene, regnskapet, e-posten og kalenderen henger sammen med ordren. Det som kommer inn ett sted, trenger ingen å taste på nytt.</p>
        </div>
        <div class="kort-rutenett">
          {INTEG.map((x) => (
            <article class="h-kort integ">
              <span class="h-eyebrow aksent">{x[0]}</span>
              <h3>{x[1]}</h3>
              <p class="h-dempet">{x[2]}</p>
            </article>
          ))}
        </div>
        <div class="h-kort regnskap">
          <h3>Regnskap</h3>
          <p class="h-dempet">Koblingen til PowerOffice Go er bygget. Bruker dere et av de andre store programmene, avklarer vi koblingen sammen med dere.</p>
          <ul>
            {ACCT.map((a) => (
              <li><b>{a[0]}</b><span class:list={["h-pille", { info: a[2] === "info" }]}>{a[1]}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Leverandørene -->
    <section id="leverandorer" class="h-seksjon">
      <div class="wrap">
        <div class="h-hode">
          <span class="h-eyebrow">Leverandørene</span>
          <h2>Færre endringer etter sending. Avvik meldes med en gang.</h2>
          <p class="h-lede">Det meste av det leverandørene sender og mottar, går gjennom de samme skjermene. Det gir bedre bestillinger og raskere svar på service.</p>
        </div>
        <div class="kort-rutenett bred">
          {SUPP.map((s) => (
            <article class="h-kort lev"><h3>{s[0]}</h3><p class="h-dempet">{s[1]}</p></article>
          ))}
        </div>
      </div>
    </section>

    <!-- Kundereisen -->
    <section id="reisen" class="h-seksjon baand">
      <div class="wrap reisen">
        <div class="h-hode ingen-marg">
          <span class="h-eyebrow">Kundereisen</span>
          <h2>Én kunde, én reise. Hvert steg har én skjerm som eier det.</h2>
          <p class="h-lede">Reisen vises som samme linje på kundekortet, tilbudet, ordren og i kundeportalen. Klikk deg gjennom stegene.</p>
        </div>
        <div class="steg-rull">
          <div class="steg-rad" role="tablist" aria-label="Steg i kundereisen" data-steg-rad>
            <span class="steg-linje" aria-hidden="true"></span>
            <span class="steg-fyll" aria-hidden="true" data-steg-fyll></span>
            {STEPS.map((x, i) => (
              <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} aria-controls="steg-kort" class:list={["steg", { valgt: i === 0 }]} data-i={i}>
                <i>{i + 1}</i><span>{x[0]}</span>
              </button>
            ))}
          </div>
        </div>
        <div class="steg-kort" id="steg-kort" role="tabpanel" aria-live="polite">
          <div class="stabel liten">
            <span class="h-pille info" data-steg-nr>Steg 1 av {STEPS.length} · {forsteSteg[1]}</span>
            <h3 class="stor" data-steg-tittel>{forsteSteg[0]}</h3>
            <p class="h-dempet" data-steg-tekst>{forsteSteg[2]}</p>
            <p class="h-dempet liten-tekst">Eies av <b data-steg-eier>{forsteSteg[3]}</b></p>
            <div class="piler">
              <button type="button" class="h-btn ikon" aria-label="Forrige steg" data-steg-forrige>‹</button>
              <button type="button" class="h-btn ikon" aria-label="Neste steg" data-steg-neste>›</button>
            </div>
          </div>
          <div>
            <Enhet id="steg-enhet" bilde={forsteSteg[4]} alt={`${forsteSteg[1]}: skjermbilde`} ratio={0.8} />
          </div>
        </div>
        <script is:inline type="application/json" id="reise-data" set:html={JSON.stringify(reiseData)} />
      </div>
    </section>

    <!-- Prinsippene -->
    <section class="h-seksjon">
      <div class="wrap">
        <div class="h-hode">
          <span class="h-eyebrow">Prinsippene</span>
          <h2>Fire grep som går igjen på alle skjermene.</h2>
        </div>
        <ol class="prinsipper">
          {PRINC.map((p, i) => (
            <li><span class="tall" aria-hidden="true">{i + 1}</span><h3>{p[0]}</h3><p class="h-dempet">{p[1]}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Kom i gang -->
    <section id="kom-i-gang" class="h-seksjon baand">
      <div class="wrap h-split">
        <div class="h-hode ingen-marg">
          <span class="h-eyebrow">Kom i gang</span>
          <h2>Fem steg før systemet gjør jobben sin.</h2>
          <p class="h-lede">Dette er den samme lista hver ny bruker ser på Min dag. Vi går gjennom stegene sammen med dere, med deres egne kunder og prislister.</p>
        </div>
        <div>
          <div class="fremdrift">
            <span data-sjekk-tekst>0 av 5</span>
            <span class="stolpe" aria-hidden="true"><i data-sjekk-stolpe></i></span>
          </div>
          <ul class="sjekkliste" data-sjekkliste>
            {CHECK.map((c) => (
              <li>
                <button type="button" role="checkbox" aria-checked="false">
                  <span class="boks" aria-hidden="true"><svg viewBox="0 0 12 12" width="12" height="12"><path d="M2.5 6.2l2.3 2.3L9.5 3.6" /></svg></span>
                  <span class="etikett">{c[0]}</span>
                  <small>{c[1]}</small>
                </button>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Spørsmål -->
    <section id="sporsmal" class="h-seksjon">
      <div class="wrap">
        <div class="h-hode">
          <span class="h-eyebrow">Spørsmål</span>
          <h2>Det folk lurer på.</h2>
        </div>
        <div class="faq">
          {FAQ.map((q, i) => (
            <div class="faq-rad">
              <h3>
                <button type="button" aria-expanded={i === 0 ? "true" : "false"} aria-controls={`faq-${i}`} data-faq>
                  <span>{q[0]}</span>
                  <span class="tegn" aria-hidden="true">{i === 0 ? "–" : "+"}</span>
                </button>
              </h3>
              <p class="h-dempet svar" id={`faq-${i}`} hidden={i !== 0}>{q[1]}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Kontakt -->
    <section id="kontakt" class="h-seksjon baand">
      <div class="wrap h-split">
        <div class="stabel">
          <span class="h-eyebrow">Kontakt</span>
          <h2>Se den med deres egne kjøkken.</h2>
          <p class="h-lede">Vi viser løsningen på en ordre som ligner deres, fra lead til etterkalkyle. Det tar rundt en time, på Teams eller i butikken.</p>
          <div class="epost">
            <span>Eller send en e-post:</span>
            <a href={`mailto:${ADDR}`}>{ADDR}</a>
            <button type="button" class="h-btn liten" data-kopier={ADDR}>Kopier</button>
            <span class="visually-hidden" role="status" data-kopier-status></span>
          </div>
          <div class="h-kort kunde">
            <b>Allerede kunde?</b>
            <span>Support: <span class="sterk">{ADDR}</span></span>
            <span>Eller trykk «Gi tilbakemelding» i appen.</span>
          </div>
          <div class="plan-kort">
            <Plantegningsstrek rom="entre" merke="Hengsel" />
          </div>
        </div>
        <form class="h-kort skjema" method="dialog" novalidate data-demo-skjema>
          <div class="par">
            <div class="h-felt"><label for="fNavn">Navn</label><input class="h-input" id="fNavn" name="navn" type="text" autocomplete="name" /></div>
            <div class="h-felt"><label for="fFirma">Butikk eller firma</label><input class="h-input" id="fFirma" name="firma" type="text" autocomplete="organization" /></div>
          </div>
          <div class="par">
            <div class="h-felt"><label for="fEpost">E-post</label><input class="h-input" id="fEpost" name="epost" type="email" autocomplete="email" /></div>
            <div class="h-felt"><label for="fTlf">Telefon</label><input class="h-input" id="fTlf" name="tlf" type="tel" autocomplete="tel" /></div>
          </div>
          <div class="h-felt"><label for="fAnt">Antall selgere</label>
            <select class="h-input" id="fAnt" name="ant">
              <option>1–3</option><option selected>4–10</option><option>11–25</option><option>Flere enn 25</option>
            </select>
          </div>
          <fieldset>
            <legend class="h-legend">Mest interessert i</legend>
            <div class="interesser">
              {INTS.map((l) => <label><input type="checkbox" name="int" value={l} />{l}</label>)}
            </div>
          </fieldset>
          <div class="h-felt"><label for="fMeld">Noe vi bør vite?</label><textarea class="h-input" id="fMeld" name="meld" placeholder="For eksempel hvilke systemer dere bruker i dag"></textarea></div>
          <button class="h-btn primar send" type="submit">Be om demo</button>
          <p class="notis" data-skjema-notis aria-live="polite">Skjemaet åpner en ferdig utfylt e-post i e-postprogrammet ditt. Ingenting lagres på nettsiden.</p>
          <p class="notis">Les hvordan vi behandler henvendelsen i <a href="/personvern">personvernerklæringen</a>.</p>
          <div class="klar" hidden data-skjema-klar><b>E-posten er klar.</b><span>Hvis e-postprogrammet ikke åpnet seg, kopier adressen over og send oss en linje.</span></div>
        </form>
      </div>
    </section>
  </main>

  <dialog class="lysboks" aria-label="Forstørret skjermbilde" data-lysboks>
    <img src="data:," alt="" />
    <button type="button" class="lukk" aria-label="Lukk">×</button>
  </dialog>
</Side>

<script>
  import "../scripts/forside";
</script>

<style>
  /* Hero */
  .hero { padding-block: clamp(40px, 7vw, 88px) clamp(56px, 8vw, 100px); }
  .hero-rutenett { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(28px, 4vw, 56px); align-items: center; }
  .hero-tekst { display: grid; gap: 22px; min-width: 0; }
  .h-lede.stor { font-size: 1.22rem; }
  .knapper { display: flex; flex-wrap: wrap; gap: 12px; }
  .fakta { list-style: none; margin: 0; padding: 6px 0 0; display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 0.92rem; color: var(--tekst-dempet); }
  .fakta li { display: inline-flex; align-items: center; gap: 8px; }
  .fakta li::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--aksent); flex: none; }
  .hero-enhet { min-width: 0; display: grid; gap: 14px; justify-items: start; }
  .hero-flate { width: 100%; aspect-ratio: 4 / 3; display: grid; place-items: center; min-width: 0; }
  @media (max-width: 900px) { .hero-rutenett { grid-template-columns: minmax(0, 1fr); } }

  /* Kort */
  .kort-rutenett { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 16px; }
  .kort-rutenett.bred { grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
  .h-kort { display: grid; gap: 10px; align-content: start; min-width: 0; }
  .hvorfor-kort { padding: 26px 26px 28px; }
  .sammenlign { margin-bottom: 28px; }
