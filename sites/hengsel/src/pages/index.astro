---
/**
 * hengsel.no – forsiden. Fasit: docs/design/hengsel/51 Hengsel nettside.dc.html (Claude Design, 08.10.2026), med
 * endringene 09.10.2026: ny logo (docs/design/hengsel/logo), Hengsel CRM og Hengsel Ute side om side øverst,
 * skjermbildene av appen fra public/skjermbilder (ute-*.webp, 2×, vist med width = halve pikselbredden),
 * kvadratiske hjørner og ingen skygger. Skjermbildene vises uten enhetsramme.
 * Seksjoner: forside med de to produktene → slik henger det sammen → Hengsel Ute (skjermbildene) → moduler →
 * integrasjoner → om oss → kontakt → bunn. Bare lys modus. Tekst i content/forside.ts.
 * Skript (ingen inline, CSP script-src 'self'): lysboksen (scripts/lysboks.ts), kontaktskjemaet (scripts/kontakt.ts),
 * som åpner en ferdig utfylt e-post, og koordinatene i plantegningen (scripts/plantegning.ts). Ingenting lagres.
 */
import Side from "../layouts/Side.astro";
import HengselLogo from "../components/HengselLogo.astro";
import PlantegningEntre from "../components/PlantegningEntre.astro";
import { CHAIN, FLOW, INTEG, MODULER, PRODUKTER, UTE_TEKST } from "../content/forside";
import { selskap } from "../content/selskap";
import { tekstFraNokkel, uteSkjermbilder } from "../lib/skjermbilder";

const ADDR = selskap.epost;

// Skjermbildene av Hengsel Ute (public/skjermbilder/ute-*.webp). Det første vises også øverst, ved siden av CRM-et.
// Fram til filene ligger der, vises dagens «I dag»-skjermbilde (public/img) øverst, og galleriet sier at bildene kommer.
const UTE = uteSkjermbilder().map((b) => {
  const t = UTE_TEKST[b.nokkel];
  return { ...b, title: t?.title ?? tekstFraNokkel(b.nokkel), text: t?.text, alt: `Hengsel Ute: ${t?.title ?? tekstFraNokkel(b.nokkel)}` };
});
const uteForst = UTE[0] ?? { src: "/img/hengsel-i-dag-a.webp", width: 390, height: 844, alt: "Hengsel Ute: I dag" };
const crm = PRODUKTER.crm.bilde;
---
<Side
  title="Hengsel – for kjøkken- og interiørbutikker"
  description="Hengsel samler CRM, kundeportal og montørappen Hengsel Ute i én løsning for kjøkken- og interiørbutikker."
  forside
  demo
  tema="light"
>
  <main id="innhold">
    <section class="hero">
      <div class="h-innhold">
        <div class="hero-tekst">
          <span class="eyebrow">For kjøkken- og interiørbutikker</span>
          <h1>Én løsning for butikken, fra første henvendelse til ferdig montert kjøkken.</h1>
          <p class="lede hero-lede">Hengsel samler salg, ordre, montasje og kundeportal på samme kundekort. Montørene har sin egen app, Hengsel Ute. Alle ser det samme kjøkkenet.</p>
          <div class="knapper">
            <a class="btn primary" href="#sammenheng">Se hvordan det virker</a>
            <a class="btn" href="#kontakt">Book en gjennomgang</a>
          </div>
        </div>

        <div class="produkter">
          <article class="produkt" id="crm">
            <div class="produkt-hode">
              <h2><HengselLogo produkt="crm" hoyde={48} /></h2>
              <span class="hvem">{PRODUKTER.crm.who}</span>
              <p class="dempet">{PRODUKTER.crm.text}</p>
              <a class="pil" href={PRODUKTER.crm.lenke.href}>{PRODUKTER.crm.lenke.label} <span aria-hidden="true">→</span></a>
            </div>
            <button type="button" class="zoom pc" data-zoom aria-label={`Forstørr skjermbildet: ${crm.alt}`}>
              <img src={crm.src} alt={crm.alt} width={Math.round(crm.px[0] / 2)} height={Math.round(crm.px[1] / 2)} loading="eager" fetchpriority="high" decoding="async" />
            </button>
          </article>
          <article class="produkt">
            <div class="produkt-hode">
              <h2><HengselLogo produkt="ute" hoyde={48} /></h2>
              <span class="hvem">{PRODUKTER.ute.who}</span>
              <p class="dempet">{PRODUKTER.ute.text}</p>
              <a class="pil" href={PRODUKTER.ute.lenke.href}>{PRODUKTER.ute.lenke.label} <span aria-hidden="true">→</span></a>
            </div>
            <button type="button" class="zoom telefon" data-zoom aria-label={`Forstørr skjermbildet: ${uteForst.alt}`}>
              <img src={uteForst.src} alt={uteForst.alt} width={uteForst.width} height={uteForst.height} loading="eager" decoding="async" />
            </button>
          </article>
        </div>
      </div>
    </section>

    <section id="sammenheng" class="seksjon h-flate">
      <div class="h-innhold">
        <div class="hode">
          <span class="eyebrow">Slik henger det sammen</span>
          <h2>Tre flater, samme ordre.</h2>
          <p class="lede">Kontoret jobber i CRM-et, kunden i Min side og montøren i Hengsel Ute. Alt ligger på samme ordre, fra lead til reklamasjon.</p>
        </div>
        <div class="tre">
          {FLOW.map((f) => (
            <article class="card flyt">
              <span class="hvem">{f.who}</span>
              <h3>{f.title}</h3>
              <p class="dempet">{f.text}</p>
            </article>
          ))}
        </div>
        <p class="kjede">
          {CHAIN.map((c, i) => <>{i > 0 && <span aria-hidden="true">›</span>}<span>{c}</span></>)}
        </p>
      </div>
    </section>

    <section id="ute" class="seksjon">
      <div class="h-innhold ute">
        <div class="hode">
          <HengselLogo produkt="ute" hoyde={48} />
          <h2>Appen for montøren, med jobben for dagen.</h2>
          <p class="lede">Montøren ser neste jobb og hva som mangler, fyller ut KS punkt for punkt og melder avvik med bilde. Alt står på ordren hos kontoret med en gang.</p>
          <div class="butikker">
            <span>Last ned i App Store</span>
            <span>Last ned i Google Play</span>
          </div>
        </div>
        {UTE.length > 0 ? (
          <ul class="galleri">
            {UTE.map((b) => (
              <li>
                <figure>
                  <button type="button" class="zoom telefon" data-zoom aria-label={`Forstørr skjermbildet: ${b.alt}`}>
                    <img src={b.src} alt={b.alt} width={b.width} height={b.height} loading="lazy" decoding="async" />
                  </button>
                  <figcaption><b>{b.title}</b>{b.text && <span class="dempet">{b.text}</span>}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
        ) : (
          <p class="dempet galleri-tom">Skjermbildene av appen kommer.</p>
        )}
      </div>
    </section>

    <section id="moduler" class="seksjon h-flate">
      <div class="h-innhold">
        <div class="hode">
          <span class="eyebrow">Moduler</span>
          <h2>Start med det dere trenger. Slå på resten etter hvert.</h2>
          <p class="lede">Løsningen er delt i elleve moduler som følger arbeidsflyten. Hver butikk velger hvilke som er på.</p>
        </div>
        <ol class="moduler">
          {MODULER.map(([b, s], i) => (
            <li>
              <span class="nr">{String(i + 1).padStart(2, "0")}</span>
              <b>{b}</b>
              <span class="dempet">{s}</span>
            </li>
          ))}
          <li class="tom" aria-hidden="true"></li>
        </ol>
      </div>
    </section>

    <section id="integrasjoner" class="seksjon">
      <div class="h-innhold">
        <div class="hode">
          <span class="eyebrow">Integrasjoner</span>
          <h2>Kobler seg på det dere allerede bruker.</h2>
        </div>
        <ul class="integ">
          {INTEG.map(([navn, tekst]) => (
            <li class="card"><b>{navn}</b><span class="dempet">{tekst}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <section id="om" class="seksjon h-flate">
      <div class="h-innhold delt om">
        <div class="hode-tekst">
          <span class="eyebrow">Om oss</span>
          <h2>Bygget i en kjøkkenbutikk.</h2>
        </div>
        <div class="om-tekst">
          <p>Hengsel er laget av Studio Sigdal Innlandet, en kjøkkenbutikk med tre avdelinger. Vi brukte løsningen i egen drift først, med egne selgere, montører og kunder.</p>
          <p>Det som ikke fungerte i butikken, ble endret. Nå tilbyr vi den til andre kjøkken- og interiørbutikker i Norden.</p>
          <p class="sted">Studio Sigdal Innlandet · Hamar · Gjøvik · Lillehammer</p>
        </div>
      </div>
    </section>

    <section id="kontakt" class="seksjon">
      <div class="h-innhold delt kontakt">
        <div class="kontakt-tekst">
          <span class="eyebrow">Book en gjennomgang</span>
          <h2>Se løsningen med deres egne kjøkken.</h2>
          <p class="lede">Vi går gjennom en ordre som ligner deres, fra lead til etterkalkyle. Det tar rundt en time, på Teams eller i butikken.</p>
          <p class="dempet">Eller send en e-post til <a href={`mailto:${ADDR}`} class="epost">{ADDR}</a></p>
          <div class="plan-kort"><PlantegningEntre /></div>
        </div>
        <form class="card skjema" novalidate data-kontakt-skjema>
          <div class="field"><label for="fNavn">Navn</label><input class="input" id="fNavn" name="navn" type="text" autocomplete="name" /></div>
          <div class="field"><label for="fFirma">Butikk</label><input class="input" id="fFirma" name="firma" type="text" autocomplete="organization" /></div>
          <div class="par">
            <div class="field"><label for="fEpost">E-post</label><input class="input" id="fEpost" name="epost" type="email" autocomplete="email" /></div>
            <div class="field"><label for="fTlf">Telefon</label><input class="input" id="fTlf" name="tlf" type="tel" autocomplete="tel" /></div>
          </div>
          <button class="btn primary send" type="submit">Book en gjennomgang</button>
          <p class="notis" data-skjema-notis aria-live="polite">Skjemaet åpner en ferdig utfylt e-post i e-postprogrammet ditt. Ingenting lagres på nettsiden.</p>
          <p class="notis">Les hvordan vi behandler henvendelsen i <a href="/personvern">personvernerklæringen</a>.</p>
        </form>
      </div>
    </section>
  </main>

  <dialog class="lysboks" aria-label="Forstørret skjermbilde" data-lysboks>
    <img src="data:," alt="" />
    <button type="button" class="lukk" aria-label="Lukk">×</button>
  </dialog>
</Side>

<script>
  import "../scripts/lysboks";
  import "../scripts/kontakt";
  import "../scripts/plantegning";
</script>

<style>
  .dempet { color: var(--muted); }
  .seksjon { padding-block: clamp(64px, 9vw, 120px); }
  .hode { display: grid; gap: 14px; margin-bottom: clamp(32px, 5vw, 56px); max-width: 760px; justify-items: start; }
  .hode-tekst { display: grid; gap: 14px; align-content: start; max-width: 760px; }
  .hvem { font-size: 0.9rem; color: var(--soft); }

  /* Skjermbilder: uten ramme, kvadratiske, 1 px linje. Klikk åpner lysboksen */
  .zoom { all: unset; display: block; max-width: 100%; cursor: zoom-in; border: 1px solid var(--line); box-sizing: content-box; }
  .zoom:focus-visible { box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--accent); }
  .zoom img { display: block; max-width: 100%; height: auto; }
  .zoom.pc { width: 100%; box-sizing: border-box; background: #f2e9db; }
  .zoom.pc img { width: 100%; }

  /* Forside: tekst, så de to produktene side om side */
  .hero { padding-block: clamp(48px, 8vw, 104px) clamp(40px, 6vw, 72px); }
  .hero-tekst { display: grid; gap: 22px; max-width: 760px; margin-bottom: clamp(40px, 6vw, 72px); }
  .hero-lede { font-size: 1.22rem; }
  .knapper { display: flex; flex-wrap: wrap; gap: 12px; }
  .produkter { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(32px, 5vw, 48px); align-items: start; }
  .produkt { display: grid; gap: 24px; align-content: start; min-width: 0; padding-top: 28px; border-top: 1px solid var(--line); }
  .produkt-hode { display: grid; gap: 10px; justify-items: start; }
  .produkt-hode h2 { margin-bottom: 8px; line-height: 0; }
  .pil { font-weight: 650; color: var(--ink); }
  .pil:hover { text-decoration: underline; }
  .produkt .telefon { justify-self: start; }

  /* Slik henger det sammen */
  .tre { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
  .flyt { padding: 28px; display: grid; gap: 12px; align-content: start; min-width: 0; }
  .kjede { margin-top: 28px; font-size: 0.95rem; color: var(--muted); display: flex; flex-wrap: wrap; gap: 6px 10px; }

  /* Hengsel Ute: skjermbildene i naturlig størrelse (width = halve pikselbredden), tre i bredden på 1180 px */
  .ute { display: grid; }
  .butikker { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .butikker span {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border-radius: var(--r-pill);
    border: 1px dashed var(--soft); color: var(--muted); font-size: 0.95rem; box-sizing: border-box;
  }
  .galleri {
    list-style: none; margin: 0; padding: 0; display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 390px), 1fr)); gap: 40px 5px; align-items: start;
  }
  .galleri li { min-width: 0; display: grid; justify-items: start; }
  figure { margin: 0; display: grid; gap: 14px; min-width: 0; max-width: 100%; }
  figcaption { display: grid; gap: 4px; }
  figcaption .dempet { font-size: 0.95rem; }
  .galleri-tom { font-size: 1.08rem; }

  /* Moduler: ruter med 1 px skille */
  .moduler {
    list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr));
    gap: 1px; background: var(--line); border: 1px solid var(--line); overflow: hidden;
  }
  .moduler li { background: var(--surface); padding: 22px 22px 24px; display: grid; gap: 6px; align-content: start; min-width: 0; }
  .moduler .nr { font-size: 0.82rem; color: var(--soft); font-variant-numeric: tabular-nums; }
  .moduler li .dempet { font-size: 0.95rem; line-height: 1.5; }

  /* Integrasjoner */
  .integ {
    list-style: none; margin: 0; padding: 0; display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 12px;
  }
  .integ li { padding: 20px 22px; display: grid; gap: 4px; align-content: start; min-width: 0; }
  .integ .dempet { font-size: 0.95rem; line-height: 1.5; }

  /* Om oss og kontakt: to kolonner fra 860 px */
  .delt { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .om-tekst { display: grid; gap: 16px; color: var(--muted); font-size: 1.08rem; min-width: 0; }
  .sted { font-size: 0.95rem; color: var(--soft); }

  .kontakt-tekst { display: grid; gap: 18px; align-content: start; min-width: 0; }
  .epost { font-weight: 650; color: var(--ink); }
  .plan-kort { width: 100%; margin-top: 8px; }
  .skjema { display: grid; gap: 14px; padding: clamp(20px, 3vw, 32px); min-width: 0; align-self: start; }
  .par { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 14px; }
  .send { justify-self: start; }
  .notis { font-size: 0.88rem; color: var(--muted); }

  @media (min-width: 860px) {
    .produkter { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .tre { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .om { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); }
    .kontakt { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); }
  }

  /* Lysboks */
  .lysboks {
    position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; border: 0;
    background: var(--lysboks); padding: clamp(12px, 3vw, 40px); cursor: zoom-out; box-sizing: border-box;
  }
  .lysboks[open] { display: grid; place-items: center; }
  .lysboks::backdrop { background: var(--lysboks); }
  .lysboks img { max-width: 100%; max-height: 92vh; width: auto; height: auto; object-fit: contain; }
  .lukk {
    position: absolute; top: 16px; right: 16px; width: 44px; height: 44px; border: 0;
    background: var(--off-white); color: var(--warm-black); font-size: 1.4rem; cursor: pointer;
  }
</style>
