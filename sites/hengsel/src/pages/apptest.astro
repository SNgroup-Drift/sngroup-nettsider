---
/**
 * hengsel.no/apptest: slik tester du Hengsel Ute (09.10.2026, erstatter S-56 v2 / K-114). Fire deler:
 *   1. iOS via TestFlight   2. Android via Google Play (Internal testing)   3. Android som APK   4. Slik melder du feil
 * Lenkene står som TODO-plassholdere øverst her (Eirik fyller dem inn). Står en lenke som TODO, vises en deaktivert
 * knapp «Lenken kommer» i den delen. Telefonen gjenkjennes i scripts/apptest.ts, som fremhever delen for din telefon.
 * Uten skript vises de tre delene likt.
 *
 * Ligger bak passord: Workeren (worker/apptest.ts) slipper bare inn med gyldig informasjonskapsel. Siden står ikke i
 * menyen, i sitemap.txt eller i lenker fra andre sider, og har noindex, nofollow. Siden er nøytral (ingen butikknavn).
 */
import Side from "../layouts/Side.astro";
import HengselLogo from "../components/HengselLogo.astro";
import { selskap } from "../content/selskap";

// TODO (Eirik): sett inn lenkene. Så lenge en står som «TODO», viser siden «Lenken kommer» i stedet for knappen.
const TESTFLIGHT_LENKE = "TODO"; // iOS: den offentlige TestFlight-lenken, https://testflight.apple.com/join/…
const PLAY_LENKE = "TODO"; // Android: lenken til Internal testing i Google Play, https://play.google.com/apps/internaltest/…
const APK_LENKE = "TODO"; // Android: direkte nedlasting av .apk-filen

const klar = (lenke: string) => !lenke.startsWith("TODO");

interface Del {
  id: string;
  enhet?: "iphone" | "android";
  nr: string;
  title: string;
  via: string;
  lenke?: { href: string; label: string };
  steps: string[];
  note?: string;
}

const DELER: Del[] = [
  {
    id: "ios", enhet: "iphone", nr: "1", title: "iOS", via: "iPhone og iPad, via TestFlight",
    lenke: { href: TESTFLIGHT_LENKE, label: "Åpne i TestFlight" },
    steps: [
      "Installer appen TestFlight fra App Store. Den er gratis og laget av Apple.",
      "Åpne TestFlight-lenken på samme iPhone eller iPad.",
      "Trykk Godta og deretter Installer i TestFlight.",
      "Åpne Hengsel Ute og logg inn med brukeren din.",
      "Tillat kamera og Bluetooth når appen spør. Det trengs for skanning og laser.",
    ],
    note: "Nye versjoner kommer i TestFlight. Slå på automatiske oppdateringer der, så slipper du å gjøre noe.",
  },
  {
    id: "google-play", enhet: "android", nr: "2", title: "Android via Google Play", via: "Internal testing i Play Butikk",
    lenke: { href: PLAY_LENKE, label: "Bli tester i Google Play" },
    steps: [
      "Gi Eirik e-postadressen til Google-kontoen du bruker på telefonen.",
      "Når du er lagt til, åpner du lenken på telefonen og trykker Bli tester.",
      "Trykk Last ned fra Google Play og installer Hengsel Ute.",
      "Logg inn med brukeren din.",
      "Tillat kamera, Bluetooth og enheter i nærheten når appen spør.",
    ],
    note: "Har du en APK-versjon av Hengsel Ute fra før, avinstaller den først. Ellers kan Play-versjonen ikke installeres.",
  },
  {
    id: "apk", enhet: "android", nr: "3", title: "Android APK", via: "Installasjonsfil uten Play Butikk",
    lenke: { href: APK_LENKE, label: "Last ned APK" },
    steps: [
      "Åpne lenken på telefonen. Filen lastes ned.",
      "Åpne filen fra varselet eller fra Nedlastinger. Tillat installasjon fra denne kilden hvis telefonen spør.",
      "Åpne Hengsel Ute og logg inn med brukeren din.",
      "Tillat kamera, Bluetooth og enheter i nærheten når appen spør.",
    ],
    note: "APK-en oppdaterer seg ikke selv. Ny versjon kommer som ny lenke. Bruk Google Play hvis du kan.",
  },
  {
    id: "feil", nr: "4", title: "Slik melder du feil", via: "Meg › Send feilrapport i appen",
    steps: [
      "Åpne Meg nederst i appen.",
      "Trykk Send feilrapport.",
      "Skriv hva du gjorde, hva som skjedde og hva du ventet. Ta gjerne med ordrenummeret.",
      "Trykk Send.",
    ],
    note: `Kommer du ikke til Meg fordi appen stopper, send en e-post til ${selskap.epost}.`,
  },
];
---
<Side
  title="Test Hengsel Ute · Hengsel"
  description="Slik installerer du testversjonen av montørappen Hengsel Ute på iPhone, iPad og Android, og slik melder du feil."
  robots="noindex, nofollow"
  lenker={DELER.map((d) => ({ label: d.title, href: `#${d.id}` }))}
>
  <main id="innhold" class="apptest">
    <section class="hero h-innhold" aria-labelledby="tittel">
      <div class="tekst">
        <span class="eyebrow">Montørappen · testversjon</span>
        <h1 id="tittel">Test Hengsel Ute</h1>
        <p class="lede">Appen er i test og ligger ikke åpent i App Store eller Play Butikk ennå. Følg delen for telefonen din, og si fra i appen når noe ikke virker.</p>
        <p class="enhetslinje" data-enhetslinje>Fire deler: iOS, Android via Google Play, Android som APK, og slik du melder feil.</p>
        <ol class="innhold" aria-label="Delene på siden">
          {DELER.map((d) => <li><a href={`#${d.id}`}><span class="nr" aria-hidden="true">{d.nr}</span>{d.title}</a></li>)}
        </ol>
      </div>
      <div class="ikoncelle">
        <div class="ikonflis">
          <picture>
            <source srcset="/img/hengsel-app-ikon-mork.svg" media="(prefers-color-scheme: dark)" />
            <img class="ikon" src="/img/hengsel-app-ikon-lys.svg" alt="" width="128" height="128" />
          </picture>
          <HengselLogo produkt="ute" hoyde={40} />
        </div>
      </div>
    </section>

    <div class="deler">
      {DELER.map((d, i) => (
        <section id={d.id} class:list={["del", { "h-flate": i % 2 === 0 }]} aria-labelledby={`${d.id}-tittel`} data-enhet={d.enhet}>
          <div class="h-innhold delrad">
            <div class="delhode">
              <span class="eyebrow">Del {d.nr}</span>
              <h2 id={`${d.id}-tittel`}>{d.title}</h2>
              <p class="dempet via">{d.via}</p>
              <span class="din" data-din hidden>Din telefon</span>
            </div>
            <div class="delinnhold">
              <ol class="steg">
                {d.steps.map((s, j) => <li><span class="stegnr" aria-hidden="true">{j + 1}</span><span class="stegtekst">{s}</span></li>)}
              </ol>
              {d.lenke && (
                klar(d.lenke.href)
                  ? <a class="btn primary lg" href={d.lenke.href} data-lenke>{d.lenke.label}</a>
                  : <div class="kommer"><button class="btn lg" type="button" disabled data-lenke>{d.lenke.label}</button><span class="dempet">Lenken kommer. Du får den av den som inviterte deg.</span></div>
              )}
              {d.note && <p class="boks">{d.note}</p>}
            </div>
          </div>
        </section>
      ))}
    </div>
  </main>
</Side>

<script>
  import "../scripts/apptest";
</script>

<style>
  .apptest { flex: 1; }
  .dempet { color: var(--muted); }
  .boks { background: var(--surface-soft); padding: 14px 16px; max-width: 62ch; }

  /* Hero */
  .hero { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; padding-block: clamp(32px, 6vw, 80px) clamp(48px, 7vw, 96px); }
  .tekst { display: grid; gap: 16px; align-content: start; }
  .enhetslinje { color: var(--muted); }
  .innhold { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 8px; }
  .innhold a { display: inline-flex; align-items: center; gap: 12px; color: var(--ink); font-weight: 650; min-height: 32px; }
  .nr, .stegnr {
    width: 32px; height: 32px; flex: none; background: var(--surface-highlight); display: grid; place-items: center;
    font-weight: 650; font-size: 0.95rem; font-variant-numeric: tabular-nums;
  }
  .ikonflis {
    background: var(--surface-highlight); padding: 28px 24px; display: grid; justify-items: center; justify-content: center; gap: 20px;
  }
  .ikon { display: block; width: 96px; height: 96px; }

  @media (min-width: 860px) {
    .hero { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 40px 64px; align-items: start; }
    .ikonflis { padding: 56px 32px; }
    .ikon { width: 128px; height: 128px; }
  }

  /* De fire delene: overskrift til venstre, steg til høyre */
  .del { padding-block: clamp(48px, 7vw, 96px); border-top: 1px solid var(--line); }
  .delrad { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px 64px; align-items: start; }
  .delhode { display: grid; gap: 8px; justify-items: start; }
  .delhode h2 { font-size: var(--t-h1); line-height: 1.08; }
  .via { font-size: 1.08rem; }
  .din { margin-top: 8px; padding: 6px 12px; background: var(--accent); color: var(--accent-ink); font-size: 0.86rem; font-weight: 650; }
  .delinnhold { display: grid; gap: 24px; justify-items: start; max-width: 720px; }
  .steg { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .steg li { display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: 14px; align-items: start; }
  .stegtekst { padding-top: 4px; }
  .kommer { display: grid; gap: 8px; justify-items: start; font-size: 0.95rem; }
  .btn.lg { white-space: normal; text-align: center; }
  /* Delen for din telefon (scripts/apptest.ts): knappen blir mørk */
  .del.valgt .btn:not(:disabled) { background: var(--ink); border-color: var(--ink); color: var(--bg); }

  @media (min-width: 860px) {
    .delrad { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); }
  }
</style>
