---
/**
 * Passordsiden for /apptest (K-107). Fasit: docs/design/hengsel/53 Apptest passord.dc.html (08.10.2026).
 * Serveres av Workeren (worker/apptest.ts) i stedet for /apptest når informasjonskapselen mangler eller er ugyldig.
 * Tilstand tom: som bygget. Tilstand feil: Workeren fjerner «hidden» på [data-feil] og setter aria-invalid på #passord.
 * Ligger under /apptest/, så den nås bare gjennom Workeren. Eget enkelt sidehode og bunn, uten meny og familiebånd.
 */
import BaseLayout from "@sngroup/design/components/BaseLayout.astro";
import "@sngroup/design/fonts.css";
import HengselLogo from "../../components/HengselLogo.astro";
import "../../styles/tokens.css";
import "../../styles/hengsel.css";
import { selskap } from "../../content/selskap";

const skrifter = ["/fonts/RecklessStandardM-Regular.woff2", "/fonts/TWKLausanne-350.woff2", "/fonts/TWKLausanne-650.woff2"];
---
<BaseLayout
  title="Hengsel apptest"
  description="Siden er for inviterte testere."
  robots="noindex, nofollow"
  temafarge={["#FBF9F6", "#1B1713"]}
  forhandslast={skrifter}
>
  <div class="side">
    <header class="hode">
      <div class="h-innhold rad">
        <a href="/" class="logo" aria-label="Hengsel – forside"><HengselLogo /></a>
      </div>
    </header>
    <main id="innhold" class="midt">
      <form method="post" action="/apptest" class="card skjema">
        <div class="tekst">
          <span class="eyebrow">Montørappen · testversjon</span>
          <h1>Hengsel apptest</h1>
          <p class="dempet">Siden er for inviterte testere. Skriv inn passordet du har fått.</p>
        </div>
        <div class="field">
          <label for="passord">Passord</label>
          <input class="input" id="passord" name="passord" type="password" autocomplete="current-password" required aria-describedby="passord-feil" />
        </div>
        <p class="feil" id="passord-feil" role="alert" data-feil hidden>Feil passord. Prøv igjen.</p>
        <button class="btn primary" type="submit">Gå videre</button>
      </form>
    </main>
    <footer class="bunn">
      <div class="h-innhold rad">
        <span>Hengsel · <a href={`mailto:${selskap.epost}`}>{selskap.epost}</a></span>
        <a href="/">Til hengsel.no</a>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  .side { min-height: 100vh; display: grid; grid-template-rows: auto 1fr auto; }
  .dempet { color: var(--muted); }
  .hode { border-bottom: 1px solid var(--line); }
  .hode .rad { height: 64px; display: flex; align-items: center; }
  .logo { display: flex; align-items: center; text-decoration: none; }
  .midt { display: grid; place-items: center; padding: clamp(32px, 8vw, 96px) clamp(16px, 4vw, 40px); }
  .skjema { width: 100%; max-width: 440px; box-sizing: border-box; padding: clamp(24px, 4vw, 36px); border-radius: 20px; display: grid; gap: 18px; }
  .tekst { display: grid; gap: 8px; }
  h1 { font-size: var(--t-h1); line-height: 1.08; }
  .input, .btn { min-height: 48px; }
  .feil {
    margin: 0; padding: 12px 14px; border-radius: 10px; background: var(--surface-soft);
    box-shadow: inset 3px 0 0 var(--bad); font-weight: 650;
  }
  .bunn { border-top: 1px solid var(--line); font-size: 0.9rem; color: var(--muted); }
  .bunn .rad { padding-block: 24px; display: flex; flex-wrap: wrap; gap: 12px 28px; justify-content: space-between; }
  .bunn a { color: inherit; }
</style>
