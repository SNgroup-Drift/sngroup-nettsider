---
import Side from "../layouts/Side.astro";
import IkkeFunnet from "@sngroup/design/components/IkkeFunnet.astro";
import Plantegningsstrek from "@sngroup/design/components/Plantegningsstrek.astro";
---
<Side title="Siden finnes ikke · Hengsel" description="Siden finnes ikke." noindex>
  <IkkeFunnet tittel="Dette rommet finnes ikke" ingress="Siden finnes ikke." oppsett="side" knapp="aksent">
    <div class="kort" slot="tegning"><Plantegningsstrek rom="entre" mangler /></div>
  </IkkeFunnet>
</Side>

<style>
  .kort { background: var(--off-white); border: 1px solid var(--beige-2); padding: 18px; }
</style>
