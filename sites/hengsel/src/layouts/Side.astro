---
/**
 * Ramme for hengsel.no: familiens BaseLayout med Hengsel-fargene og -skriftene, toppfeltet (Toppfelt) og bunnen
 * (Familiebaand + bunntekst). Fasit: docs/design/hengsel/Sidehode.dc.html og Bunn.dc.html.
 * Sidehodet har menypunkter per side (prop «lenker», som i Sidehode.dc.html).
 */
import BaseLayout from "@sngroup/design/components/BaseLayout.astro";
import "@sngroup/design/fonts.css";
import Toppfelt from "@sngroup/design/components/Toppfelt.astro";
import HengselLogo from "@sngroup/design/components/HengselLogo.astro";
import Bunn from "../components/Bunn.astro";
import "../styles/tokens.css";
import "../styles/hengsel.css";

interface Lenke { label: string; href: string }
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Overstyrer robots-taggen (/apptest: "noindex, nofollow") */
  robots?: string;
  /** Forsiden: logoen og «Til toppen» peker til #hjem */
  forside?: boolean;
  /** Linjen om demodata i bunnteksten */
  demo?: boolean;
  /** Menypunktene i sidehodet. Standard: forsidens fire, med lenke tilbake til forsiden */
  lenker?: Lenke[];
  /** "light" låser lys modus (forsiden). Uten følger siden systemet. */
  tema?: "light";
}
const { title, description, noindex, robots, forside = false, demo = false, tema } = Astro.props;
const h = forside ? "" : "/";
const lenker = Astro.props.lenker ?? [
  { label: "Slik henger det sammen", href: `${h}#sammenheng` },
  { label: "Moduler", href: `${h}#moduler` },
  { label: "Hengsel Ute", href: `${h}#ute` },
  { label: "Om oss", href: `${h}#om` },
];
const skrifter = ["/fonts/RecklessStandardM-Regular.woff2", "/fonts/TWKLausanne-350.woff2", "/fonts/TWKLausanne-650.woff2"];
---
<BaseLayout
  title={title}
  description={description}
  noindex={noindex}
  robots={robots}
  tema={tema}
  temafarge={["#FBF9F6", "#1B1713"]}
  ikonPng="/favicon-32.png"
  appleIkon="/apple-touch-icon-180.png"
  forhandslast={skrifter}
>
  <div class="side" id="hjem">
    <Toppfelt
      hjem={forside ? "#hjem" : "/"}
      ordmerke="Hengsel"
      kompakt
      fast
      strek
      skjulUnder={900}
      kontaktVariant="fylt"
      kontaktHref={`${h}#kontakt`}
      kontaktTekst="Be om demo"
      lenker={lenker}
    >
      <HengselLogo slot="logo" />
    </Toppfelt>
    <slot />
    <Bunn demo={demo} forside={forside} />
  </div>
</BaseLayout>

<style>
  .side { min-height: 100vh; display: flex; flex-direction: column; }
  /* Logoen i toppfeltet: 28 px («engsel»), 24 px under 900 px, som før */
  @media (max-width: 900px) {
    .side :global(.toppfelt .hengsel-logo) { height: 30px; width: auto; }
  }
</style>
