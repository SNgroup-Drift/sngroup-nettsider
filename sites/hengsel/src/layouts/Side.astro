---
/**
 * Ramme for hengsel.no: familiens BaseLayout med Hengsel-fargene, toppfeltet (Toppfelt) og bunnen (Familiebaand + bunntekst).
 */
import BaseLayout from "@sngroup/design/components/BaseLayout.astro";
import Toppfelt from "@sngroup/design/components/Toppfelt.astro";
import HengselLogo from "../components/HengselLogo.astro";
import Bunn from "../components/Bunn.astro";
import "../styles/tokens.css";
import "../styles/hengsel.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Forsiden: lenkene i toppfeltet peker til ankre på samme side */
  forside?: boolean;
  demo?: boolean;
}
const { title, description, noindex, forside = false, demo = false } = Astro.props;
const h = forside ? "" : "/";
---
<BaseLayout title={title} description={description} noindex={noindex}>
  <div class="side" id="hjem">
    <Toppfelt
      hjem={forside ? "#hjem" : "/"}
      ordmerke="Hengsel"
      fast
      strek
      skjulUnder={900}
      kontaktVariant="fylt"
      kontaktHref={`${h}#kontakt`}
      kontaktTekst="Be om demo"
      lenker={[
        { label: "Se løsningen", href: `${h}#losningen` },
        { label: "Montørappen", href: `${h}#hengsel` },
        { label: "Kundereisen", href: `${h}#reisen` },
        { label: "Spørsmål", href: `${h}#sporsmal` },
      ]}
    >
      <HengselLogo slot="logo" />
    </Toppfelt>
    <slot />
    <Bunn demo={demo} forside={forside} />
  </div>
</BaseLayout>

<style>
  .side { min-height: 100vh; display: flex; flex-direction: column; }
</style>
