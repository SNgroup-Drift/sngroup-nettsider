---
/**
 * Plantegning av entréen (1:50, mål i mm) i kontaktdelen på forsiden. Fasit: docs/design/hengsel/Plantegning Entre.dc.html.
 * Koordinatene øverst til høyre følger pekeren (scripts/plantegning.ts). Uten skript står de på x 0 · y 0 mm.
 */
---
<figure class="plan" data-plantegning>
  <div class="hode" aria-hidden="true">
    <span>Plantegning · 1:50</span>
    <span data-koord>x 0 · y 0 mm</span>
  </div>
  <svg viewBox="0 0 360 300" role="img" aria-label="Plantegning av en entré, 2 800 × 2 400 mm, med døra på et hengsel">
    <path d="M40 14 H320 M40 9 V19 M320 9 V19" class="maal" />
    <text x="180" y="10" text-anchor="middle" class="maaltekst">2 800</text>
    <path d="M336 30 V270 M331 30 H341 M331 270 H341" class="maal" />
    <text x="348" y="150" text-anchor="middle" transform="rotate(90 348 150)" class="maaltekst">2 400</text>
    <g class="inventar">
      <rect x="52" y="42" width="140" height="60" rx="2" />
      <path d="M122 42 V102" />
      <path d="M58 72 H186" stroke-dasharray="4 3" />
      <rect x="272" y="60" width="36" height="120" rx="2" />
      <rect x="212" y="218" width="60" height="40" rx="2" />
    </g>
    <text x="64" y="176" class="rom">ENTRÉ</text>
    <text x="64" y="190" class="merke">Hengsel</text>
    <path d="M200 270 H40 V30 H320 V270 H280" class="vegg" />
    <path d="M200 190 A80 80 0 0 1 280 270" class="slag" />
    <line x1="200" y1="270" x2="200" y2="190" class="dor" />
    <circle cx="200" cy="270" r="3" class="hengsel" />
  </svg>
</figure>

<style>
  .plan { margin: 0; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 18px; color: var(--ink); }
  .hode { display: flex; justify-content: space-between; gap: 12px; font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
  svg { display: block; width: 100%; height: auto; margin-top: 6px; }
  .maal { fill: none; stroke: var(--muted); stroke-width: 1; }
  .maaltekst { fill: var(--muted); font: 500 10px var(--f-body); }
  .inventar { fill: none; stroke: var(--ink); stroke-width: 1; opacity: 0.75; }
  .rom { fill: var(--ink); font: 500 10px var(--f-body); letter-spacing: 0.12em; }
  .merke { fill: var(--muted); font: 400 10px var(--f-body); }
  .vegg { fill: none; stroke: var(--ink); stroke-width: 1.5; stroke-linecap: square; }
  .slag { fill: none; stroke: var(--ink); stroke-width: 0.8; stroke-dasharray: 3 3; }
  .dor { stroke: var(--ink); stroke-width: 1.5; }
  .hengsel { fill: var(--accent); }
</style>
