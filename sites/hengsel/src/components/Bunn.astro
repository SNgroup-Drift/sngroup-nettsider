---
/**
 * Bunnen på hengsel.no: SN Group-båndet og bunnteksten. Fasit: docs/design/hengsel/Bunn.dc.html (10.10.2026).
 * demo = linjen om demodata (bare på forsiden, der skjermbildene vises). epost = adressen i bunnteksten (hei@hengsel.no på forsiden).
 */
import { selskap } from "../content/selskap";

interface Props { demo?: boolean; forside?: boolean; epost?: string }
const { demo = false, forside = false, epost = selskap.epost } = Astro.props;
---
<aside class="baand" aria-label="SN Group" data-familiegrep="familiebaand">
  <div class="h-innhold rad">
    <a href="https://sngroup.no" class="avsender">
      <svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
        <rect width="32" height="32" rx="7" class="flate" />
        <path d="M8 8h16v16H8z" class="strek" stroke-width="2.5" />
        <path d="M16 8v8h8" class="strek" stroke-width="1.5" />
        <circle cx="8" cy="24" r="2" class="punkt" />
      </svg>
      <span>En del av SN Group</span>
    </a>
    <nav aria-label="Søstersider" class="sider">
      <a href="https://sngroup.no">sngroup.no</a>
      <span aria-hidden="true">·</span>
      <span aria-current="page" class="her">hengsel.no</span>
      <span aria-hidden="true">·</span>
      <a href="https://byggem.no">byggem.no</a>
    </nav>
  </div>
</aside>
<footer class="bunn">
  <div class="h-innhold rad">
    <span>Hengsel · {selskap.navn} · org.nr. {selskap.orgnr} · <a href={`mailto:${epost}`}>{epost}</a></span>
    {demo && <span>Skjermbildene viser demodata. Navn og tall er ikke ekte.</span>}
    <span class="lenker"><a href="/personvern">Personvern</a><span aria-hidden="true">·</span>{forside ? <a href="#hjem">Til toppen</a> : <a href="/">Til forsiden</a>}</span>
  </div>
</footer>

<style>
  .baand { background: var(--bg); color: var(--ink); border-top: 1px solid var(--line); }
  .baand .rad {
    padding-block: 28px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px;
  }
  .avsender { display: flex; align-items: center; gap: 12px; color: var(--ink); text-decoration: none; font-size: 0.95rem; }
  .avsender:hover { text-decoration: none; }
  svg { flex: none; display: block; }
  .flate { fill: var(--ink); }
  .strek { fill: none; stroke: var(--bg); }
  .punkt { fill: var(--dusty-blue); }
  .sider { display: flex; flex-wrap: wrap; gap: 6px 10px; font-size: 0.95rem; color: var(--muted); }
  .sider a { color: var(--muted); }
  .sider a:hover { color: var(--ink); }
  .her { color: var(--ink); }

  .bunn { border-top: 1px solid var(--line); font-size: 0.9rem; color: var(--muted); background: var(--bg); }
  .bunn .rad { padding-block: 32px 40px; display: flex; flex-wrap: wrap; gap: 12px 28px; justify-content: space-between; }
  .bunn a { color: inherit; }
  .lenker { display: flex; gap: 8px; }
</style>
