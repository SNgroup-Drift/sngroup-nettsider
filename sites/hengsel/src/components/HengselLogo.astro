---
/**
 * Hengsel-logoen (logopakken 09.10.2026, docs/design/hengsel/logo/LES-MEG.md): merket (vater, skap og ovn) + «engsel»,
 * og med produkt («CRM» eller «UTE») under ordet, høyrestilt, med hake over.
 * Fasit: hengsel-logo-lys/-mork.svg, hengsel-crm-logo-*.svg og hengsel-ute-logo-*.svg. Markeringen er kopiert derfra.
 *
 * Logofilene har ordet som <text> i TWK Lausanne, så SVG-en ligger inline (en <img> kan ikke bruke sidens skrift).
 * Fargene som skifter med bakgrunnen (skap, ord og produktnavn) er CSS-variabler fra tokens.css (--merke-skap,
 * --merke-ord): Beige 1 og Warm Black på lys bunn (filene -lys), Krem og Off White på mørk (filene -mork).
 * Vater, grep, ovn og hake er alltid Deep Blue / #8FA9D1, som i filene. Ikke strekk, roter eller legg på skygge.
 */
interface Props {
  /** Produktnavn under ordet. Uten: bare «Hengsel» */
  produkt?: "crm" | "ute";
  /** Høyden i px (hele logoen). Standard 34 (sidehodet). Luft rundt logoen: minst merkets høyde */
  hoyde?: number;
}
const { produkt, hoyde = 34 } = Astro.props;
const navn = produkt ? `Hengsel ${produkt.toUpperCase()}` : "Hengsel";
const vb = produkt ? "-4 -4 460 128" : "-4 -4 460 112";
const bredde = Math.round((hoyde * 460) / (produkt ? 128 : 112));
---
<svg class="logo" viewBox={vb} width={bredde} height={hoyde} role="img" aria-label={navn}>
  <title>{navn}</title>
  <g>
    <rect x="0" y="0" width="10" height="72" rx="1" fill="#8FA9D1" />
    <rect class="skap" x="0" y="0" width="10" height="4.2" rx="1" />
    <rect class="skap" x="0" y="2.8" width="10" height="1.4" />
    <rect class="skap" x="0" y="67.8" width="10" height="4.2" rx="1" />
    <rect class="skap" x="0" y="67.8" width="10" height="1.4" />
    <rect class="skap" x="1.8" y="6.7" width="6.4" height="4.6" rx="2.3" />
    <rect x="2.5" y="7.1" width=".6" height="3.8" fill="#5074A9" />
    <rect x="6.9" y="7.1" width=".6" height="3.8" fill="#5074A9" />
    <ellipse cx="5" cy="9" rx="1.4" ry="1" fill="#8FA9D1" />
    <rect class="skap" x="2.6" y="28" width="4.8" height="16" rx="2.4" />
    <rect x="3" y="33.5" width="4" height=".6" fill="#5074A9" />
    <rect x="3" y="38.5" width="4" height=".6" fill="#5074A9" />
    <ellipse cx="5" cy="36" rx="1" ry="1.5" fill="#8FA9D1" />
    <rect x="3.5" y="51" width="3" height="13.5" rx="1.5" fill="#5074A9" />
    <rect class="skap" x="35.1" y="0" width="14" height="27.6" />
    <rect class="skap" x="12.5" y="0" width="22" height="23.8" />
    <rect x="12.5" y="25.3" width="22" height="2.3" fill="#8FA9D1" />
    <rect class="skap" x="12.5" y="39" width="39.1" height="6" />
    <rect class="skap" x="35.1" y="46.5" width="14" height="25.5" />
    <rect x="37.8" y="49.4" width="2.5" height="6.1" rx="1.25" fill="#5074A9" />
    <rect class="skap" x="12.5" y="46.5" width="22" height="25.5" />
    <circle cx="18" cy="49.6" r="1.5" fill="#5074A9" />
    <circle cx="23.5" cy="49.6" r="1.5" fill="#5074A9" />
    <circle cx="28.9" cy="49.6" r="1.5" fill="#5074A9" />
    <rect x="15" y="52.6" width="17" height="2.3" rx="1.15" fill="#5074A9" />
    <rect x="15.4" y="56.6" width="16.2" height="13" rx=".4" fill="#5074A9" />
    <rect x="51" y="0" width=".6" height="39" fill="#5074A9" />
    <rect x="51" y="45" width=".6" height="27" fill="#5074A9" />
    <rect class="skap" x="51.6" y="0" width="22" height="72" />
    <rect x="54.3" y="36.5" width="2.5" height="6.1" rx="1.25" fill="#5074A9" />
  </g>
  <text class="ord" font-weight="350" font-size="96" letter-spacing="-1.5" x="80" y="69">engsel</text>
  {produkt && (
    <>
      <text class="produkt" x="378" y="112" text-anchor="end" font-weight="650" font-size="20" letter-spacing="2.4" fill-opacity=".6">{produkt.toUpperCase()}</text>
      <path d="M385 94 l9 9 l18 -20" fill="none" stroke="#5074A9" stroke-width="4.6" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
</svg>

<style>
  .logo { display: block; flex: none; max-width: 100%; height: auto; overflow: visible; }
  .skap { fill: var(--merke-skap); }
  .ord, .produkt { fill: var(--merke-ord); font-family: var(--font-tekst); }
</style>
