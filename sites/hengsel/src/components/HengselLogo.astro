---
/**
 * Hengsel-logoen: H-merket (to skapdører, grep i Deep Blue) + «engsel» + hake over «CRM».
 * Fasit: Brand i Hengsel designsystem (docs/design/hengsel/_ds/…/_ds_bundle.js og components.css).
 * Ordet tegnes med --font-tekst (Inter nå, TWK Lausanne når lisensen er klar). Under 28 px brukes det lille merket.
 */
interface Props { size?: number }
const { size = 28 } = Astro.props;
const liten = size <= 28;
const d = liten
  ? { a: 2.5, w: 25.5, h: 67, x2: 36, sw: 5, gy: 29, gh: 14, r: 7 }
  : { a: 1.5, w: 26.5, h: 69, x2: 36, sw: 3, gy: 31, gh: 10, r: 5 };
---
<span class="logo" role="img" aria-label="Hengsel CRM">
  <svg class="merke" viewBox="0 0 64 72" aria-hidden="true">
    <rect class="dor" x={d.a} y={d.a} width={d.w} height={d.h} stroke-width={d.sw} />
    <rect class="dor" x={d.x2} y={d.a} width={d.w} height={d.h} stroke-width={d.sw} />
    <rect class="grep" x="17" y={d.gy} width="13" height={d.gh} rx={d.r} />
    <rect class="grep" x="34" y={d.gy} width="13" height={d.gh} rx={d.r} />
  </svg><span class="ord" aria-hidden="true">engsel</span><svg class="crm" viewBox="0 0 25 20" aria-hidden="true"><path class="hake" d="M1.17 5.24l3.33 3.33l6.67 -7.4" /><text x="0" y="19.6">CRM</text></svg>
</span>

<style>
  .logo {
    display: inline-flex; align-items: baseline; font: 350 28px/1 var(--font-tekst); color: var(--merke-ord);
    letter-spacing: -0.01em; white-space: nowrap; padding-top: 0.3em;
  }
  .merke { height: 0.713em; width: auto; flex: none; align-self: baseline; margin-right: 0.04em; }
  .dor { fill: var(--merke-dor); stroke: var(--merke-linje); }
  .grep { fill: var(--merke-grep); }
  .ord { font-weight: 350; }
  /* «CRM» og haken som SVG (som logofilene): versaler 650, 0,06 em, hake i Deep Blue over */
  .crm { height: 0.534em; width: auto; margin-left: 0.248em; align-self: baseline; overflow: visible; }
  .crm text { fill: var(--merke-crm); font: 650 10px var(--font-tekst); letter-spacing: 0.6px; }
  .hake { fill: none; stroke: var(--merke-grep); stroke-width: 2.33; stroke-linecap: round; stroke-linejoin: round; }
  @media (max-width: 900px) { .logo { font-size: 24px; } }
</style>
