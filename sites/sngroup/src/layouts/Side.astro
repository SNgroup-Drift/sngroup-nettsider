---
import BaseLayout from "@sngroup/design/components/BaseLayout.astro";
import SiteHeader from "@sngroup/design/components/SiteHeader.astro";
import SiteFooter from "@sngroup/design/components/SiteFooter.astro";
import { selskap } from "../content/selskap";

interface Props { title: string; description?: string; noindex?: boolean }
const {
  title,
  description = "SN Group – ES-HOLDING AS, Trondheim. Kjøkken og interiør, eiendom og egne digitale verktøy, blant annet montørappen Hengsel.",
  noindex,
} = Astro.props;
const hjem = Astro.url.pathname === "/" ? "" : "/";
---
<BaseLayout title={title} description={description} noindex={noindex}>
  <SiteHeader
    ordmerke={selskap.merkenavn}
    undertekst={selskap.navn}
    lenker={[
      { href: `${hjem}#virksomheter`, label: "Virksomheter" },
      { href: `${hjem}#hengsel`, label: "Hengsel" },
      { href: `${hjem}#kontakt`, label: "Kontakt", primar: true },
    ]}
  />
  <slot />
  <SiteFooter
    selskap={selskap.navn}
    orgnr={selskap.orgnr}
    adresse={selskap.adresse}
    epost={selskap.epost}
    personvernTekst="Personvern · Hengsel"
    visDelAv={false}
  />
</BaseLayout>
