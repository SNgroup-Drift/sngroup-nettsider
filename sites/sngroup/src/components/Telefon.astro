---
/**
 * Prøv Hengsel: en liten telefon med tre faner (I dag, Jobb, KS) og «Uten dekning».
 * Eksempeldata fra dagens sngroup.no. Ingenting sendes noe sted.
 */
const JOBB = ["Tegning og ordrebekreftelse", "3 leverandører levert", "Kontrollmål vegg og vindu", "Ferdigmelding"];
const JOBB_START = [false, true, false, false];
const KS = ["Skap i lodd og vater", "Festet i bærende vegg", "Fronter justert, like fuger", "Ryddet og rengjort"];
---
<div class="scene" data-telefon>
  <div class="telefon" role="region" aria-label="Eksempel på montørappen Hengsel">
    <div class="skjerm">
      <div class="panel" id="hp-dag" role="tabpanel" aria-labelledby="hf-dag" data-panel="dag">
        <p class="skjermtittel">I dag</p>
        <div class="kort hi"><small>Neste jobb · 07:30</small><b>Kjøkken, Hamar</b>Tegning · 3 leverandører · KS</div>
        <div class="kort"><small>I morgen</small><b>Bad, Lillehammer</b></div>
        <div class="kort"><small>Torsdag</small><b>Garderobe, Gjøvik</b></div>
      </div>
      <div class="panel" id="hp-jobb" role="tabpanel" aria-labelledby="hf-jobb" data-panel="jobb" hidden>
        <p class="skjermtittel">Kjøkken, Hamar</p>
        <div class="bar"><i data-bar="jobb"></i></div>
        {JOBB.map((t, i) => (
          <button type="button" class="sjekk" role="checkbox" aria-checked={String(JOBB_START[i])} data-jobb>
            <span class="boks" aria-hidden="true"></span>{t}
          </button>
        ))}
      </div>
      <div class="panel" id="hp-ks" role="tabpanel" aria-labelledby="hf-ks" data-panel="ks" hidden>
        <p class="skjermtittel">KS Kjøkken</p>
        <div class="bar"><i data-bar="ks"></i></div>
        {KS.map((t) => (
          <div class="ks" role="group" aria-label={t} data-ks>
            <span>{t}</span>
            <span class="seg">
              <button type="button" class="ok" aria-pressed="false">OK</button>
              <button type="button" class="av" aria-pressed="false">Avvik</button>
            </span>
          </div>
        ))}
      </div>
      <div class="ko" aria-live="polite" data-ko hidden></div>
      <div class="faner" role="tablist" aria-label="Faner i appen">
        <button type="button" role="tab" id="hf-dag" aria-controls="hp-dag" aria-selected="true" data-fane="dag">I dag</button>
        <button type="button" role="tab" id="hf-jobb" aria-controls="hp-jobb" aria-selected="false" tabindex="-1" data-fane="jobb">Jobb</button>
        <button type="button" role="tab" id="hf-ks" aria-controls="hp-ks" aria-selected="false" tabindex="-1" data-fane="ks">KS</button>
      </div>
    </div>
  </div>
  <button type="button" class="bryter" role="switch" aria-checked="false" data-dekning>
    <span class="sw" aria-hidden="true"></span>Uten dekning
  </button>
</div>

<style>
  .scene { display: grid; justify-items: center; gap: 16px; }
  .telefon {
    width: min(320px, 100%);
    aspect-ratio: 320 / 640;
    background: var(--enhet);
    border-radius: 40px;
    padding: 14px;
    box-shadow: 0 30px 60px -30px rgb(43 36 32 / 0.45);
    color: var(--enhet-tekst);
    display: flex;
    flex-direction: column;
  }
  .skjerm { flex: 1; border-radius: 28px; padding: 22px 16px 12px; display: flex; flex-direction: column; gap: 10px; overflow: hidden; min-height: 0; }
  .panel { display: flex; flex-direction: column; gap: 10px; }
  .panel[hidden], .ko[hidden] { display: none; }
  .skjermtittel { margin: 0 0 4px; font: 400 26px/1.2 var(--font-overskrift); }
  .kort { background: var(--enhet-kort); border-radius: 14px; padding: 12px 14px; font-size: 13px; line-height: 1.35; }
  .kort small { display: block; font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.8; margin-bottom: 3px; }
  .kort b { font-weight: 600; font-size: 15px; display: block; }
  .kort.hi { background: var(--enhet-fremhevet); color: var(--enhet-fremhevet-tekst); }
  .faner { display: flex; gap: 4px; background: var(--enhet-kort); border-radius: 999px; padding: 4px; margin-top: auto; }
  .faner button { flex: 1; border: 0; background: transparent; color: var(--enhet-tekst); border-radius: 999px; padding: 10px 0; font-size: 13px; }
  .faner button[aria-selected="true"] { background: var(--enhet-tekst); color: var(--enhet); }
  .sjekk { display: flex; align-items: center; gap: 10px; background: var(--enhet-kort); border-radius: 12px; padding: 10px 12px; font-size: 13px; border: 0; color: var(--enhet-tekst); text-align: left; width: 100%; }
  .boks { width: 18px; height: 18px; border-radius: 5px; border: 1.5px solid var(--enhet-fremhevet); display: grid; place-items: center; font-size: 11px; flex: none; }
  .sjekk[aria-checked="true"] .boks { background: var(--enhet-fremhevet); color: var(--enhet-fremhevet-tekst); }
  .sjekk[aria-checked="true"] .boks::after { content: "✓"; }
  .ks { display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center; background: var(--enhet-kort); border-radius: 12px; padding: 8px 10px 8px 12px; font-size: 13px; }
  .seg { display: flex; border: 1px solid rgb(216 204 188 / 0.4); border-radius: 999px; overflow: hidden; }
  .seg button { border: 0; background: transparent; color: var(--enhet-tekst); font-size: 12px; padding: 6px 10px; }
  .seg .ok[aria-pressed="true"] { background: var(--enhet-fremhevet); color: var(--enhet-fremhevet-tekst); }
  .seg .av[aria-pressed="true"] { background: var(--dis); color: var(--umbra); }
  .bar { height: 4px; background: var(--enhet-kort); border-radius: 4px; overflow: hidden; }
  .bar i { display: block; height: 100%; width: 0; background: var(--enhet-fremhevet); transition: width 0.3s; }
  .ko { font-size: 12px; background: var(--dis); color: var(--umbra); border-radius: 10px; padding: 8px 10px; }
  .bryter { display: flex; align-items: center; gap: 10px; font-size: 15px; color: var(--tekst-dempet); background: none; border: 0; min-height: 44px; }
  .sw { width: 38px; height: 22px; border-radius: 999px; background: var(--linje); position: relative; }
  .sw::after { content: ""; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: var(--bakgrunn); transition: transform 0.2s; }
  .bryter[aria-checked="true"] .sw { background: var(--aksent); }
  .bryter[aria-checked="true"] .sw::after { transform: translateX(16px); }
</style>

<script>
  const scene = document.querySelector<HTMLElement>("[data-telefon]");
  if (scene) {
    const faner = [...scene.querySelectorAll<HTMLButtonElement>("[data-fane]")];
    const paneler = [...scene.querySelectorAll<HTMLElement>("[data-panel]")];
    const ko = scene.querySelector<HTMLElement>("[data-ko]")!;
    const dekning = scene.querySelector<HTMLButtonElement>("[data-dekning]")!;
    let utenDekning = false;
    let venter = 0;

    const visKo = (tekst: string | null) => {
      ko.hidden = tekst === null;
      ko.textContent = tekst ?? "";
    };
    const endret = () => {
      if (!utenDekning) return;
      venter += 1;
      visKo(`Uten dekning · ${venter} ${venter === 1 ? "endring venter" : "endringer venter"} og sendes når du har nett`);
    };
    const oppdaterBar = (navn: string, antall: number) => {
      const bar = scene.querySelector<HTMLElement>(`[data-bar="${navn}"]`);
      if (bar) bar.style.width = `${(antall / 4) * 100}%`;
    };
    const tellJobb = () =>
      oppdaterBar("jobb", scene.querySelectorAll('[data-jobb][aria-checked="true"]').length);
    const tellKs = () => oppdaterBar("ks", scene.querySelectorAll('[data-ks] [aria-pressed="true"]').length);

    const visFane = (id: string, fokus = false) => {
      for (const f of faner) {
        const valgt = f.dataset.fane === id;
        f.setAttribute("aria-selected", String(valgt));
        f.tabIndex = valgt ? 0 : -1;
        if (valgt && fokus) f.focus();
      }
      for (const p of paneler) p.hidden = p.dataset.panel !== id;
    };
    faner.forEach((f, i) => {
      f.addEventListener("click", () => visFane(f.dataset.fane!));
      f.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        const neste = faner[(i + (e.key === "ArrowRight" ? 1 : faner.length - 1)) % faner.length];
        visFane(neste.dataset.fane!, true);
      });
    });

    for (const b of scene.querySelectorAll<HTMLButtonElement>("[data-jobb]")) {
      b.addEventListener("click", () => {
        b.setAttribute("aria-checked", String(b.getAttribute("aria-checked") !== "true"));
        tellJobb();
        endret();
      });
    }
    for (const rad of scene.querySelectorAll<HTMLElement>("[data-ks]")) {
      const knapper = [...rad.querySelectorAll<HTMLButtonElement>("button")];
      for (const k of knapper) {
        k.addEventListener("click", () => {
          for (const a of knapper) a.setAttribute("aria-pressed", String(a === k));
          tellKs();
          endret();
        });
      }
    }

    dekning.addEventListener("click", () => {
      utenDekning = !utenDekning;
      dekning.setAttribute("aria-checked", String(utenDekning));
      if (utenDekning) {
        visKo(`Uten dekning · ${venter} ${venter === 1 ? "endring venter" : "endringer venter"} og sendes når du har nett`);
      } else if (venter > 0) {
        venter = 0;
        visKo("Sendt ✓");
        setTimeout(() => !utenDekning && visKo(null), 2500);
      } else {
        visKo(null);
      }
    });

    tellJobb();
    tellKs();
  }
</script>
