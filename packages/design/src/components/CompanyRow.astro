---
/**
 * Virksomhet som rad: navn, kort tekst, stikkord og utgående lenke(r).
 * Bygd på <details>, så raden virker uten JavaScript.
 */
interface Lenke { href: string; label: string; primar?: boolean }
interface Props {
  id: string;
  navn: string;
  undertittel?: string;
  tekst: string;
  stikkord?: string[];
  lenker?: Lenke[];
  apen?: boolean;
  /** Teksten mangler og er en plassholder */
  plassholder?: boolean;
}
const { id, navn, undertittel, tekst, stikkord = [], lenker = [], apen = false, plassholder = false } = Astro.props;
const ekstern = (href: string) => /^https?:/.test(href);
---
<details class="rad" id={`rad-${id}`} data-rad={id} open={apen}>
  <summary>
    <span class="navn">
      <h3>{navn}</h3>
      {undertittel && <span class="under">{undertittel}</span>}
    </span>
    <span class="pluss" aria-hidden="true">+</span>
  </summary>
  <div class="innhold">
    <p class:list={{ plassholder }} data-plassholder={plassholder ? "" : undefined}>{tekst}</p>
    <div class="side">
      {stikkord.length > 0 && (
        <ul class="stikkord" aria-label="Stikkord">
          {stikkord.map((s) => <li>{s}</li>)}
        </ul>
      )}
      {lenker.length > 0 && (
        <p class="lenker">
          {lenker.map((l) => (
            <a href={l.href} class:list={["pill", { solid: l.primar }]} rel={ekstern(l.href) ? "noopener" : undefined}>
              {l.label}{ekstern(l.href) && <span aria-hidden="true"> ↗</span>}
            </a>
          ))}
        </p>
      )}
    </div>
  </div>
</details>

<style>
  .rad { border-bottom: 1px solid var(--linje-svak); }
  summary {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 24px 0;
    cursor: pointer;
  }
  summary::-webkit-details-marker { display: none; }
  .navn { display: grid; gap: 4px; }
  h3 { font-size: clamp(28px, 3.4vw, 44px); font-weight: 300; }
  .under { font-size: 15px; color: var(--tekst-dempet); }
  summary:hover h3, .rad[open] h3 { color: var(--aksent); }
  .pluss {
    width: 44px;
    height: 44px;
    border: 1px solid var(--linje-svak);
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 20px;
    transition: transform 0.35s;
  }
  .rad[open] .pluss { transform: rotate(45deg); background: var(--tekst); color: var(--bakgrunn); border-color: var(--tekst); }
  .innhold {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 20px 48px;
    padding-bottom: 32px;
  }
  .innhold > p { margin: 0; color: var(--tekst-dempet); max-width: 56ch; }
  .plassholder { font-style: italic; }
  .side { display: grid; gap: 16px; align-content: start; }
  .stikkord { list-style: none; margin: 0; padding: 0; display: flex; gap: 8px; flex-wrap: wrap; }
  .stikkord li {
    font-size: 13px;
    border: 1px solid var(--linje-svak);
    border-radius: var(--radius-pille);
    padding: 5px 12px;
    background: var(--bakgrunn);
  }
  .lenker { margin: 0; display: flex; gap: 10px; flex-wrap: wrap; }
  @media (max-width: 860px) { .innhold { grid-template-columns: 1fr; } }
</style>
