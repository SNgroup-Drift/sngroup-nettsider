---
/**
 * Mal for personvernsider. Avsnitt kan ha tekst (HTML tillatt, f.eks. mailto-lenker) og punktlister.
 * Innholdet kommer fra sidens egen content-fil, aldri fra brukere.
 */
import type { Avsnitt } from "../types";

interface Props {
  /** Liten etikett over overskriften */
  etikett?: string;
  /** Ingress under overskriften */
  ingress?: string;
  /** Overskrift. Ordet i tittelAksent settes i kursiv aksent. */
  tittel: string;
  tittelAksent?: string;
  oppdatert?: string;
  behandlingsansvarlig: string;
  kontakt: string;
  avsnitt: Avsnitt[];
}
const { etikett = "Personvern", ingress, tittel, tittelAksent, oppdatert, behandlingsansvarlig, kontakt, avsnitt } = Astro.props;
---
<div class="topp">
  <div class="wrap">
    <div class="label">{etikett}</div>
    <h1>{tittel}{tittelAksent && <> <em>{tittelAksent}</em></>}</h1>
    {ingress && <p class="ingress">{ingress}</p>}
    {oppdatert && <p class="oppdatert">{oppdatert}</p>}
    <p class="ansvar">
      <span>Behandlingsansvarlig: {behandlingsansvarlig}</span>
      <span>Kontakt: <a href={`mailto:${kontakt}`}>{kontakt}</a></span>
    </p>
  </div>
</div>

<section class="avsnitt">
  <div class="wrap">
    {avsnitt.map((a) => (
      <div class="prad">
        <h2>{a.overskrift}</h2>
        <div class="tekst">
          {a.tekst?.map((t) => <p set:html={t} />)}
          {a.boks && <div class="boks"><p set:html={a.boks} /></div>}
          {a.punkter && <ul>{a.punkter.map((p) => <li set:html={p} />)}</ul>}
          {a.etter?.map((t) => <p set:html={t} />)}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .topp { padding-block: clamp(32px, 6vw, 80px) clamp(32px, 5vw, 56px); }
  h1 { margin: 20px 0 16px; }
  .ingress { color: var(--tekst-dempet); font-size: 1.18rem; max-width: 62ch; margin: 0 0 16px; }
  .oppdatert { color: var(--tekst-dempet); margin: 0; }
  .ansvar { margin: 12px 0 0; display: flex; flex-wrap: wrap; gap: 4px 24px; color: var(--tekst-dempet); font-size: 15px; }
  .ansvar a { color: var(--tekst); }
  .avsnitt { padding-bottom: var(--seksjon); }
  .prad {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 16px 64px;
    padding-block: 32px;
    border-bottom: 1px solid var(--linje-svak);
  }
  .prad:first-child { border-top: 1px solid var(--linje-svak); }
  h2 { font-size: 26px; font-weight: 400; line-height: 1.25; }
  .tekst { max-width: 62ch; }
  .tekst :global(p) { margin: 0; }
  .tekst :global(p + p), .tekst :global(ul + p), .tekst :global(p + ul) { margin-top: 14px; }
  .tekst :global(ul) { margin: 0; padding-left: 20px; }
  .tekst :global(li) { margin-bottom: 8px; }
  .tekst :global(li::marker) { color: var(--aksent); }
  .tekst :global(a) { color: var(--tekst); text-underline-offset: 3px; }
  .boks { background: var(--flate); border-radius: var(--radius); padding: 20px 22px; margin-top: 14px; }
  .boks + :global(ul), .boks + :global(p) { margin-top: 14px; }
  @media (max-width: 860px) { .prad { grid-template-columns: 1fr; } }
</style>
