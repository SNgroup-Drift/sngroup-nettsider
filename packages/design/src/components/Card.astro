---
/** Kort på flate med valgfri lenke. */
interface Props {
  tittel: string;
  href?: string;
  lenketekst?: string;
}
const { tittel, href, lenketekst = "Les mer" } = Astro.props;
---
<article class="kort">
  <h3>{tittel}</h3>
  <div class="innhold"><slot /></div>
  {href && <a href={href}>{lenketekst}</a>}
</article>

<style>
  .kort {
    background: var(--bakgrunn);
    border: 1px solid var(--linje);
    border-radius: var(--radius);
    padding: 20px;
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .innhold { color: var(--tekst-dempet); }
  .innhold :global(p) { margin: 0; }
  a {
    justify-self: start;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-block: 6px 2px;
  }
</style>
