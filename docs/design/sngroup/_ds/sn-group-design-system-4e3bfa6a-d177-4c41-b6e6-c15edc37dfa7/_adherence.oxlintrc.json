{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/card/**",
              "components/company/**",
              "components/contact/**",
              "components/core/**",
              "components/footer/**",
              "components/header/**",
              "components/layout/**",
              "components/privacy/**",
              "ui_kits/sngroup/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader Variable|Inter Variable))/i]",
        "message": "Font not provided by the design system. Available: Newsreader Variable, Inter Variable."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|pil|children|onClick|disabled|type|className|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, href, pil, children, onClick, disabled, type, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline)$/]",
        "message": "<Button> variant must be one of 'solid' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tittel|href|lenketekst|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tittel, href, lenketekst, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComingSoon'] > JSXAttribute > JSXIdentifier[name!=/^(?:navn|tekst|children|key|ref|className|style|children)$/]",
        "message": "<ComingSoon> doesn't accept that prop. Declared props: navn, tekst, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompanyRowLenke'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|label|primar|key|ref|className|style|children)$/]",
        "message": "<CompanyRowLenke> doesn't accept that prop. Declared props: href, label, primar."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:epost|selskap|orgnr|adresse|children|key|ref|className|style|children)$/]",
        "message": "<ContactBlock> doesn't accept that prop. Declared props: epost, selskap, orgnr, adresse, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avsnitt'] > JSXAttribute > JSXIdentifier[name!=/^(?:overskrift|tekst|punkter|etter|key|ref|className|style|children)$/]",
        "message": "<Avsnitt> doesn't accept that prop. Declared props: overskrift, tekst, punkter, etter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|tittel|ingress|flate|className|children|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: id, label, tittel, ingress, flate, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:selskap|orgnr|adresse|epost|personvern|personvernTekst|visDelAv|onPersonvern|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: selskap, orgnr, adresse, epost, personvern, personvernTekst, visDelAv, onPersonvern."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeaderLenke'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|label|primar|onClick|key|ref|className|style|children)$/]",
        "message": "<SiteHeaderLenke> doesn't accept that prop. Declared props: href, label, primar, onClick."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
